Bootstrap: docker
From: alpine:edge
Stage: build

%post
    apk update
    apk --no-cache upgrade
    apk add --no-cache alpine-sdk git pkgconf autoconf automake

    cd /root/
    git clone https://github.com/allinurl/gwsocket
    cd gwsocket
    autoreconf -fiv
    ./configure
    make

Bootstrap: docker
From: alpine:edge
Stage: final

%files from build
    /root/gwsocket/gwsocket /usr/bin/

%post
    apk update
    apk --no-cache upgrade
    apk --no-cache add libcurl ffmpeg-libs snapcast-server openssl fmt spdlog

%runscript
    #!/bin/ash
    snapserver --config "$1" &
    
    mkfifo /tmp/music_pipe
    "$2" "$3" > /tmp/music_pipe &
    music_pid=$!
    gwsocket --port=9000 --addr=0.0.0.0 --std < /tmp/music_pipe &
    gwsocket_pid=$!

    # Wait for music to exit
    wait $music_pid
    # Kill gwsocket when music exits
    kill -TERM $gwsocket_pid 2>/dev/null
    wait $gwsocket_pid 2>/dev/null
    rm /tmp/music_pipe
